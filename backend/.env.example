# ======================================================================
# PaperRec configuration. Copy to `.env` and edit.
# Every value is optional - the app runs with sensible defaults.
# ======================================================================

# --- server -----------------------------------------------------------
HOST=127.0.0.1
PORT=7000
FLASK_ENV=development
SECRET_KEY=change-me-in-production
CORS_ORIGINS=*

# --- storage ----------------------------------------------------------
# Default: SQLite file inside backend/data (zero setup)
DB_PATH=
# Set MONGO_URI to switch to MongoDB (pymongo required)
MONGO_URI=
MONGO_DB=paperrec

# Set NEO4J_URI + NEO4J_PASSWORD to switch to Neo4j (neo4j driver required)
NEO4J_URI=
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# --- paper sources ----------------------------------------------------
# auto = probe the network once; on = always live; off = offline corpus only
ONLINE_MODE=auto
ARXIV_ENABLED=true
S2_ENABLED=true
# Free key from https://www.semanticscholar.org/product/api - lifts rate limits
S2_API_KEY=
HTTP_TIMEOUT=6
LIVE_RESULT_LIMIT=25

# --- AI ---------------------------------------------------------------
# auto | sentence-transformers | tfidf
EMBEDDING_PROVIDER=auto
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384
# auto | faiss | numpy
VECTOR_BACKEND=auto

# none | gemini | openai | groq  (none = deterministic template summaries)
LLM_PROVIDER=none
LLM_API_KEY=
LLM_MODEL=

# --- recommendation ---------------------------------------------------
TOP_K=12
CANDIDATE_LIMIT=120
MMR_LAMBDA=0.75
SIMILARITY_KNN=6
SIMILARITY_EDGE_THRESHOLD=0.02

W_SEMANTIC=0.52
W_INFLUENCE=0.14
W_CITATION=0.12
W_RECENCY=0.12
W_PERSONAL=0.10
